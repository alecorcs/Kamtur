<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/imgPerfil"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_profile_message"/>

    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/imgPerfil"
        android:padding="5dp"
        android:textSize="18sp"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/white"
        android:background="@drawable/background_conver_receptor"
        android:text="@string/mensajeText"/>

    <ImageView
        android:id="@+id/imgEnviadaReceptor"
        android:layout_toEndOf="@+id/imgPerfil"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="5dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvVisto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/tvMensaje"
        android:visibility="gone"/>
</RelativeLayout>