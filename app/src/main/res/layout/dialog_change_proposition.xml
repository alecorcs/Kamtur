<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@color/kamtur_background_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/hacerProposicion"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black" />
    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginBottom="15dp"
        android:layout_marginTop="10dp" />
<!--
    <TextView
        android:id="@+id/tvNombreTurno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/nombreTurno"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:textStyle="bold"
        android:background="@color/white"
        android:layout_marginBottom="5dp"/>
-->
    <Spinner
        android:id="@+id/spinTurnos"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp"
        android:minHeight="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrponerCambio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/proponer"/>

</androidx.appcompat.widget.LinearLayoutCompat>